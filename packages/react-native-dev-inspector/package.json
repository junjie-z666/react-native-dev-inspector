{
  "name": "@azsxdc12356/react-native-dev-inspector",
  "version": "1.2.2",
  "description": "Click on React Native components to jump to source code in your IDE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metro": {
      "types": "./dist/metro.d.ts",
      "default": "./dist/metro.js"
    },
    "./rn-compat": {
      "types": "./dist/rn-compat.d.ts",
      "default": "./dist/rn-compat.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "react-native",
    "expo",
    "inspector",
    "devtools",
    "debug",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "VaheSaroyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjie-z666/react-native-dev-inspector.git",
    "directory": "packages/react-native-dev-inspector"
  },
  "bugs": {
    "url": "https://github.com/junjie-z666/react-native-dev-inspector/issues"
  },
  "homepage": "https://github.com/junjie-z666/react-native-dev-inspector#readme",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.68.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "metro": {
      "optional": true
    },
    "metro-config": {
      "optional": true
    },
    "expo-dev-client": {
      "optional": true
    },
    "expo-dev-menu": {
      "optional": true
    }
  },
  "dependencies": {
    "launch-editor": "2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0"
  }
}
